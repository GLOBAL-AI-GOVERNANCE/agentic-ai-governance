      "capabilities": ["read:approved-public-information", "draft:internal-summary"],
      "tools": [
        {"tool_id": "tool.example.search", "action_level": 1},
        {"tool_id": "tool.example.draft", "action_level": 2}
      ]
    },
    {
      "agent_id": "agent.example.researcher",
      "display_name": "Research sub-agent",
      "parent": "agent.example.lead",
      "maximum_action_level": 4,
      "action_terms": ["network_call"],
      "tools": [{"tool_id": "tool.example.search", "action_level": 1}]
    },
    {
      "agent_id": "agent.example.writer",
      "display_name": "Writing sub-agent",
      "parent": "agent.example.lead",
      "maximum_action_level": 2,
      "capabilities": ["read:approved-public-information", "draft:internal-summary"],
      "tools": [{"tool_id": "tool.example.draft", "action_level": 2}]
    }
  ]
}
