{
  "policy_kind": "global-ai-governance.fleet-issuance-policy",
  "policy_version": "0.1.0",
  "issuer_id": "operator.example.fleet-issuer",
  "validity_days": 30,
  "revocation_refresh_hours": 24,
  "agents": [
    {
      "agent_id": "agent.example.lead",
      "display_name": "Lead agent",
      "maximum_action_level": 4,
      "delegates": true,
